<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        VortexGram icon — vortex funnel design.
        Outer group keeps content in the adaptive-icon safe zone (66% of 108dp).
    -->
    <group
        android:scaleX="0.66"
        android:scaleY="0.66"
        android:translateX="18.36"
        android:translateY="18.36">

        <!-- Vortex rotation ring 1 — wide, near top of funnel (semi-transparent) -->
        <path
            android:fillColor="#55FFFFFF"
            android:pathData="M26,36 Q54,25 82,36 Q54,47 26,36 Z" />

        <!-- Vortex rotation ring 2 — medium, mid-funnel -->
        <path
            android:fillColor="#44FFFFFF"
            android:pathData="M34,54 Q54,44 74,54 Q54,64 34,54 Z" />

        <!-- Vortex rotation ring 3 — narrow, near tip -->
        <path
            android:fillColor="#33FFFFFF"
            android:pathData="M42,70 Q54,62 66,70 Q54,78 42,70 Z" />

        <!-- Left arm of V: smooth bezier crescent, wide at top, narrows to center tip -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M 16,22 L 30,22 Q 40,52 50,82 L 48,84 Q 33,54 12,22 Z" />

        <!-- Right arm of V: mirror of left arm -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M 92,22 L 78,22 Q 68,52 58,82 L 60,84 Q 75,54 96,22 Z" />

        <!-- Tip dot — fills the V point and ties both arms together -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M 54,82 m -4,0 a 4,4,0,1,0,8,0 a 4,4,0,1,0,-8,0" />

    </group>
</vector>
